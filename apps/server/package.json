{
  "name": "@ziglive/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:real-stack": "tsx src/integration/real-stack.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/index.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@ziglive/protocol": "workspace:*",
    "fastify": "5.12.1",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/ws": "8.18.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
