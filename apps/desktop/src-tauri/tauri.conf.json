{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "atomis",
  "version": "0.1.2",
  "identifier": "dev.osmait.atomis",
  "build": {
    "frontendDist": "../shell",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Atomis",
        "width": 1400,
        "height": 900,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "binaries/atomis-server"
    ],
    "resources": {
      "resources/": "resources/"
    }
  }
}
